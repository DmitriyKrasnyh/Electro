# Скопируйте этот файл в .env и подставьте значения из панели Supabase:
# Project Settings → API Keys (или кнопка Connect вверху панели).
# Адрес проекта:
VITE_SUPABASE_URL=https://ВАШ-ПРОЕКТ.supabase.co
# Публичный ключ (начинается с sb_publishable_). Секретный ключ sb_secret_ сюда не ставьте:
# всё, что начинается с VITE_, попадает в приложение на телефоне.
VITE_SUPABASE_PUBLISHABLE_KEY=
